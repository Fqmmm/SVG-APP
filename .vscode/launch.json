{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SVG App Tools",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/vscode-extension/examples"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "build SVG extension"
    }
  ]
}
