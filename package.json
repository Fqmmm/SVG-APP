{
  "name": "svg-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 SVG command-line editor",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "cli": "npm run build && node dist/src/main.js",
    "metrics": "node scripts/collect-metrics.mjs",
    "check:boundaries": "node scripts/collect-metrics.mjs --check-boundaries",
    "metrics:check": "node scripts/collect-metrics.mjs --verify",
    "test:stats": "npm run build && node --test dist/tests/plugins/StatsCommand.test.js",
    "test:dir": "npm run build && node --test dist/tests/plugins/DirCommand.test.js dist/tests/plugins/DirectoryAdapter.test.js",
    "test:loader": "npm run build && node --test \"dist/tests/composition/*.test.js\"",
    "test:box": "npm run build && node --test dist/tests/plugins/BoxPlugin.test.js dist/tests/plugins/BoxIntegration.test.js dist/tests/composition/BoxConfigAssembly.test.js dist/tests/composition/BoxAssembly.test.js"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "import-meta-resolve": "4.2.0"
  }
}
